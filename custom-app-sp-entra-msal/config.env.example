# Service Principal (Azure AD) Configuration
SP_TENANT_ID=your-tenant-id-here
SP_CLIENT_ID=your-service-principal-app-id-here
SP_CLIENT_SECRET=your-service-principal-secret-here

# Databricks Service Principal Configuration
# This is the client_id sent to Databricks token exchange endpoint
# Can be the same as SP_CLIENT_ID or different if you have separate registrations
DATABRICKS_SP_CLIENT_ID=your-databricks-sp-client-id-here

# Application Configuration
PORT=9001
FLASK_SECRET_KEY=your-secret-key-here

# Note: Service Principal authentication does NOT require:
# - REDIRECT_URI (no browser redirect - non-interactive)
# - OAUTH_SCOPE (uses /.default automatically)
# - User credentials (authenticates as the SP app)

# Optional: Databricks Configuration
# These will be prompted for in the app
# DATABRICKS_WORKSPACE_URL=https://your-workspace.databricks.com
# DATABRICKS_WAREHOUSE_ID=your-warehouse-id
# MODEL_SERVING_ENDPOINT=https://your-workspace.databricks.com/serving-endpoints/your-model/invocations

