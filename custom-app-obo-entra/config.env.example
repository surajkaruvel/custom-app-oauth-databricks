# ==============================================================================
# Databricks OAuth - On-Behalf-Of (OBO) Flow Configuration
# ==============================================================================
# This app demonstrates the OBO flow where a middle-tier service exchanges
# a user token for Databricks access without requiring Databricks token exchange.
#
# Architecture:
# 1. User authenticates to Middle-Tier (API1)
# 2. Middle-Tier uses OBO to get token for Databricks scope (API2)
# 3. Token works DIRECTLY with Databricks APIs
# ==============================================================================

# ------------------------------------------------------------------------------
# Middle-Tier App Configuration (API1)
# ------------------------------------------------------------------------------
# This is your app that the user authenticates to
MIDDLETIER_TENANT_ID=your-tenant-id-here
MIDDLETIER_CLIENT_ID=your-middletier-client-id-here
MIDDLETIER_CLIENT_SECRET=your-middletier-client-secret-here

# ------------------------------------------------------------------------------
# Databricks Scope Configuration (API2)
# ------------------------------------------------------------------------------
# The scope for the Databricks app registration that the OBO token will access
# Format: <databricks-app-client-id>/user_impersonation
DATABRICKS_SCOPE=your-databricks-client-id-here/user_impersonation

# ------------------------------------------------------------------------------
# Snowflake Scope Configuration (API4)
# ------------------------------------------------------------------------------
# The scope for the Snowflake app registration that the OBO token will access
# Format: api://<snowflake-app-client-id>/snowflake
SNOWFLAKE_SCOPE=api://your-snowflake-client-id-here/snowflake

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
PORT=9001
REDIRECT_URI=http://localhost:9001/callback

# Flask secret key for session management (generate a secure random key)
FLASK_SECRET_KEY=your-secure-random-secret-key-here

# ==============================================================================
# SETUP INSTRUCTIONS
# ==============================================================================
#
# 1. Copy this file to config.env and fill in your actual values
# 2. NEVER commit config.env to version control
#
# Middle-Tier App Setup:
# ----------------------
# - Create app registration in Entra ID
# - Set redirect URI: http://localhost:9001/callback
# - Create client secret
# - Add API permission: api://<middletier-client-id>/access_as_user
# - Expose API with scope: api://<middletier-client-id>/access_as_user
#
# Databricks App Setup:
# ---------------------
# - Create separate app registration for Databricks
# - Expose API with scope: user_impersonation
# - Configure federation policy in Databricks
# - Use this app's client ID in DATABRICKS_SCOPE
#
# OBO Configuration:
# ------------------
# - In middle-tier app, add delegated permission to Databricks app
# - Ensure admin consent is granted
# - Test the OBO flow
#
# ==============================================================================

